# ─────────────────────────────────────────────────────────────────────────────
# ComplianceOS — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# IMPORTANT: quote any value that contains `#`, `$` or spaces, otherwise the
# dotenv parser used by Next.js treats the rest of the line as a comment.
#   Correct:   DB_PASSWORD="LocalDev#2026"
#   Wrong:     DB_PASSWORD=LocalDev#2026        -> password resolves to "LocalDev"
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (MySQL 8 or MariaDB 10.6+) ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=compliance_app
DB_PASSWORD="change-me#2026"
DB_NAME=compliance_platform
DB_CONNECTION_LIMIT=10

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=ComplianceOS
APP_URL=http://localhost:3001
NODE_ENV=development

# Session signing secret — at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=8
SESSION_REMEMBER_TTL_HOURS=720

# AES-256-GCM key used to encrypt integration secrets stored in `settings`.
# Must be 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters

# ─── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
UPLOAD_MAX_FILE_SIZE_MB=25

# ─── Email (SMTP / SendGrid / Microsoft 365) ─────────────────────────────────
# Leave SMTP_HOST empty to run in simulated mode: every email is still written to
# email_logs with provider = 'simulated', so nothing is lost during setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="ComplianceOS"
SMTP_REPLY_TO=support@example.com

# ─── SMS (Twilio or MSG91) ───────────────────────────────────────────────────
SMS_PROVIDER=twilio            # twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=PLATFM
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PLATFM

# ─── WhatsApp (Meta Cloud API or Twilio) ─────────────────────────────────────
WHATSAPP_PROVIDER=meta         # meta | twilio
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# ─── Backups (used by `npm run backup:db`) ───────────────────────────────────
BACKUP_PATH=./storage/backups
BACKUP_RETENTION_DAYS=30

# Full path to mysqldump when it is not on PATH (e.g. XAMPP on Windows) - used by Settings > Backup and npm run backup:db
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe

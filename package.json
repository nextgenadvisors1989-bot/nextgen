{
  "name": "compliance-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Compliance, Audit, HR, Payroll & Workforce Management Platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "serve": "node scripts/serve.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:seed": "tsx scripts/run-seeds.ts",
    "db:sync-permissions": "tsx scripts/run-seeds.ts --permissions-only",
    "db:demo": "python scripts/seed-demo.py",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:alignment": "node scripts/alignment-audit.mjs",
    "db:reset": "tsx scripts/reset-database.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "send:reminders": "tsx scripts/send-reminders.ts",
    "backup:db": "tsx scripts/backup-database.ts",
    "verify:employees": "bash scripts/verify-employees.sh",
    "check:pdf": "tsx scripts/check-pdf.ts",
    "verify:auditors": "bash scripts/verify-auditors.sh",
    "verify:assignments": "bash scripts/verify-assignments.sh",
    "verify:reports": "bash scripts/verify-reports.sh",
    "verify:auditor-workspace": "bash scripts/verify-auditor-workspace.sh",
    "verify:dynamic-modules": "bash scripts/verify-dynamic-modules.sh",
    "fixture:phase3": "python3 scripts/fixture-phase3.py",
    "verify:compliance": "bash scripts/verify-compliance.sh",
    "verify:files": "bash scripts/verify-files.sh",
    "verify:logs": "bash scripts/verify-logs.sh",
    "verify:users": "bash scripts/verify-users.sh",
    "verify:settings": "bash scripts/verify-settings.sh",
    "verify:cms": "bash scripts/verify-cms.sh",
    "verify:calendar": "bash scripts/verify-calendar.sh",
    "verify:payroll": "bash scripts/verify-payroll.sh",
    "verify:selfservice": "bash scripts/verify-selfservice.sh",
    "verify:capar": "python scripts/verify-capar.py",
    "verify:water-noc": "python scripts/verify-water-noc.py",
    "verify:step3": "python scripts/verify-step3-forms.py",
    "verify:step4": "python scripts/verify-step4.py",
    "db:seed-designations": "python scripts/seed-demo.py designations",
    "db:seed-evidence": "python scripts/seed-demo.py evidence",
    "db:seed-masters": "tsx scripts/seed-masters.ts",
    "parse:evidence": "python -I scripts/parse-evidence-checklist.py",
    "parse:designations": "python -I scripts/parse-designations.py",
    "verify:billing": "python scripts/verify-billing.py",
    "verify:site": "node scripts/verify-site.mjs",
    "test:calculators": "tsx scripts/test-calculators.ts",
    "test:gst": "tsx scripts/test-gst.ts",
    "test:water-usage": "tsx scripts/test-water-usage.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "mysql2": "^3.11.5",
    "next": "^15.5.27",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}